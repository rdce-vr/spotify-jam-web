# ==========================================
# Spotify Developer Credentials
# Get them from https://developer.spotify.com/dashboard
# ==========================================
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Server Port (Default: 37685)
PORT=37685

# Spotify OAuth Redirect URI (Must match the Redirect URI in Spotify Dashboard)
REDIRECT_URI=http://127.0.0.1:37685/api/auth/callback

# Optional: Custom Public URL (e.g. for Cloudflare Tunnel or reverse proxy)
# PUBLIC_URL=https://jam.yourdomain.com
